# agent-store — environment variables
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real keys.

# --- Razorpay (TEST MODE ONLY — this project never touches live keys) -------
# Dashboard → Account & Settings → API Keys (with the Test/Live toggle on Test).
# Test keys always start with `rzp_test_`.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Dashboard → Account & Settings → Webhooks → the secret you typed when creating
# the webhook pointing at {PUBLIC_BASE_URL}/webhooks/razorpay.
# Subscribe at least to: payment_link.paid, payment.captured, order.paid.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Persistence -----------------------------------------------------------
# Neon Postgres POOLED connection string (the host contains `-pooler`).
# The pooled/websocket driver is required: transactions are how audit events
# commit atomically with state (ADR-0003).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Ingestion (M4) --------------------------------------------------------
# Read only by the ingestion pipeline and the S3 extraction spike, never by the
# server at boot — a deployment that only serves an already-ingested catalog
# does not need these set. platform.openai.com → API keys.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# The vision model that reads photos+captions. Unset means `gpt-5-mini`, the
# default S3 measured. Set it to `gpt-5` for the S3 step-up (PLAN §7, spec story
# 42): swapping models is this variable and nothing else — no source file names
# a model. Both are recorded at fixtures/extraction-spike/runs/.
EXTRACTION_MODEL=gpt-5-mini

# --- Server ----------------------------------------------------------------
# Render injects PORT itself; locally this is the port Express binds.
PORT=3000

# Public HTTPS origin of this deployment, no trailing slash. Used to build the
# Razorpay Payment Link callback URL and advertised in the MCP tool output.
PUBLIC_BASE_URL=https://agent-store.onrender.com

# --- Merchant face (S1.1) --------------------------------------------------
# The bearer token a merchant presents on `/merchant/mcp`. Optional: unset, the
# seed mints one (`mrc_tok_…`) and prints it exactly once. Set it to keep a
# token stable across redeploys of a fresh database — an already-minted token
# is never rotated, so setting this later has no effect.
MERCHANT_TOKEN=

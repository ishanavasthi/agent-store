# agent-store — environment variables
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real keys.

# --- Razorpay (TEST MODE ONLY — this project never touches live keys) -------
# Dashboard → Account & Settings → API Keys (with the Test/Live toggle on Test).
# Test keys always start with `rzp_test_`.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Dashboard → Account & Settings → Webhooks → the secret you typed when creating
# the webhook pointing at {PUBLIC_BASE_URL}/webhooks/razorpay.
# Subscribe at least to: payment_link.paid, payment.captured, order.paid.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Persistence -----------------------------------------------------------
# Neon Postgres POOLED connection string (the host contains `-pooler`).
# The pooled/websocket driver is required: transactions are how audit events
# commit atomically with state (ADR-0003).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Ingestion (M4) --------------------------------------------------------
# Read only by the ingestion pipeline and the S3 extraction spike, never by the
# server at boot — a deployment that only serves an already-ingested catalog
# does not need these set. platform.openai.com → API keys.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Extraction provider (S2.2) --------------------------------------------
# Extraction is provider-agnostic: these variables are the whole swap, and no
# source file names a provider or a model. With ONLY `OPENAI_API_KEY` set, the
# call is byte-identical to the one the committed accuracy run was produced
# with — everything below is optional.

# `openai` (Responses API) or `openrouter` (OpenAI-compatible Chat Completions).
EXTRACTION_PROVIDER=openai

# The key for whichever provider is selected. Falls back to `OPENAI_API_KEY` or
# `OPENROUTER_API_KEY` when unset, so an existing machine keeps working.
EXTRACTION_API_KEY=

# The vision model that reads photos+captions. Unset means `gpt-5-mini`, the
# default S3 measured — but only for `openai`; `openrouter` has no default and
# requires this (e.g. `z-ai/glm-5.3-flash`), because a guessed model id spends
# money on the wrong model.
EXTRACTION_MODEL=gpt-5-mini

# Override the provider's API root (no trailing slash). Defaults:
# https://api.openai.com/v1 · https://openrouter.ai/api/v1
EXTRACTION_BASE_URL=

# How the payload is requested: `json_schema` (a `response_format`) or
# `tool_call` (a forced `record_extraction` function call whose parameters are
# the schema). Defaults to json_schema for openai and tool_call for openrouter,
# which accepts `response_format` without enforcing it. Either way every payload
# is validated by us with zod before it is believed.
EXTRACTION_OUTPUT_MODE=

# `false` for a text-only model. An image submitted while this is false is a
# loud error, never a silently caption-only extraction. Defaults to true.
EXTRACTION_VISION=

# Per-request abort timeout in milliseconds. Defaults to 60000. Three attempts
# are made on 429/5xx, honouring a small `Retry-After`.
EXTRACTION_TIMEOUT_MS=

# OpenRouter attribution, sent as `HTTP-Referer` and `X-Title`. Optional.
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# --- Server ----------------------------------------------------------------
# Render injects PORT itself; locally this is the port Express binds.
PORT=3000

# Public HTTPS origin of this deployment, no trailing slash. Used to build the
# Razorpay Payment Link callback URL and advertised in the MCP tool output.
PUBLIC_BASE_URL=https://agent-store.onrender.com

# --- Merchant face (S1.1) --------------------------------------------------
# The bearer token a merchant presents on `/merchant/mcp`. Optional: unset, the
# seed mints one (`mrc_tok_…`) and prints it exactly once. Set it to keep a
# token stable across redeploys of a fresh database — an already-minted token
# is never rotated, so setting this later has no effect.
MERCHANT_TOKEN=

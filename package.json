{
  "name": "agent-store",
  "version": "0.1.0",
  "private": true,
  "description": "Merchant-side agentic commerce infrastructure",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "build": "npm run build:server && npm run build:viewer",
    "build:server": "tsc -p tsconfig.build.json",
    "build:viewer": "vite build viewer",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:viewer": "tsc -p viewer/tsconfig.json --noEmit",
    "dev:viewer": "vite viewer",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types src/db/migrate.ts",
    "db:seed": "node --experimental-strip-types src/db/seed.ts",
    "spike:extraction": "npm run build && node dist/ingestion/spike/runExtractionSpike.js",
    "evals:live": "npm run build:server && node dist/evals/live/cli.js",
    "failure:decline": "npm run build:server && node dist/failures/declineRehearsal.js",
    "failure:oversell": "npm run build:server && node dist/failures/oversellRehearsal.js",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:seed:prod": "node dist/db/seed.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "razorpay": "^2.9.8",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.246",
    "@electric-sql/pglite": "^0.5.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
